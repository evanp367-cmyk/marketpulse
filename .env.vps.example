# MarketPulse production settings. Copy this file to .env on the VPS.
# Never commit the real .env file or paste secrets into chat.
APP_NAME=MarketPulse
ENVIRONMENT=production
DEV_AUTH_ENABLED=false

# PostgreSQL runs as a private Docker service on THIS VPS.
# Generate the password with: openssl rand -hex 32
# Hex characters avoid URL-encoding problems in the internal DATABASE_URL.
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32

# Telegram bot from @BotFather; username WITHOUT @.
TELEGRAM_BOT_TOKEN=PUT_REAL_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Optional: your trusted foreign HTTP CONNECT or SOCKS5 proxy. Never paste its credentials into chat.
TELEGRAM_PROXY_URL=
TELEGRAM_PRO_PRICE_STARS=250
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
SUPPORT_ADMIN_IDS=YOUR_NUMERIC_TELEGRAM_USER_ID

# Public frontend URL; include /marketpulse/ when repository is named marketpulse.
MINI_APP_URL=https://YOUR_GITHUB_USERNAME.github.io/marketpulse/
# CORS is origin-only. No path and no trailing slash.
CORS_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io

# Free DuckDNS subdomain, hostname only; no protocol or path.
API_DOMAIN=marketpulse-api.duckdns.org

BINANCE_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision/ws
MARKET_STALE_AFTER_SECONDS=30
